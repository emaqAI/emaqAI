<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.cpumonitorai.statslogger</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/CPU Monitor AI.app/Contents/MacOS/CPUMonitor</string>
        <string>--log-sample</string>
    </array>
    <!-- Must match StatsStore.sampleInterval. -->
    <key>StartInterval</key>
    <integer>60</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardErrorPath</key>
    <string>/Users/tomekemaq/Library/Logs/cpumonitorai-statslogger.log</string>
</dict>
</plist>
