#!/bin/sh
# SX25 toolbox — uruchamiane przy starcie Alpine (usługa 'local').
# Doinstalowuje narzędzia po podniesieniu sieci.
set +e

# Włącz repozytorium community (tam jest m.in. dosbox) i zaktualizuj indeksy.
setup-apkrepos -1 >/dev/null 2>&1 || true
apk update >/dev/null 2>&1 || true

# DOSBox — emulator DOS (repo community).
apk add dosbox >/dev/null 2>&1 || echo "SX25: nie udało się zainstalować dosbox" >&2

# box64 — uruchamianie binariów x86_64 (dostępny głównie na ARM/RISC-V;
# na hoście x86 zwykle zbędny — instalujemy best-effort zgodnie z życzeniem).
apk add box64 >/dev/null 2>&1 || echo "SX25: box64 niedostępny w repo dla tej architektury" >&2

# --- SSH (dostęp zdalny kluczem) --------------------------------------------
if apk add openssh >/dev/null 2>&1; then
  # Upewnij się, że główny sshd_config dołącza pliki drop-in z sshd_config.d/.
  if [ -f /etc/ssh/sshd_config ] && ! grep -q '^Include /etc/ssh/sshd_config.d/\*.conf' /etc/ssh/sshd_config; then
    printf '\nInclude /etc/ssh/sshd_config.d/*.conf\n' >> /etc/ssh/sshd_config
  fi
  # Uprawnienia klucza (tar mógł ich nie zachować).
  chmod 700 /root/.ssh 2>/dev/null || true
  chmod 600 /root/.ssh/authorized_keys 2>/dev/null || true
  # Klucze hosta i start usługi.
  ssh-keygen -A >/dev/null 2>&1 || true
  rc-service sshd start >/dev/null 2>&1 || /usr/sbin/sshd 2>/dev/null || \
    echo "SX25: nie udało się uruchomić sshd" >&2
else
  echo "SX25: nie udało się zainstalować openssh" >&2
fi

exit 0
